# REQUIRED. Where your movie files live: an absolute path, or a path
# relative to the backend/ folder, e.g. /mnt/media/movies. This path must
# already exist — pigflix refuses to start if it's unset, missing, or not
# a directory.
MOVIES_FOLDER=

# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Password required to enter admin mode in the frontend (unlocks the "Fix
# match" button on the movie detail screen). Leave unset to disable admin
# mode entirely (the lock button will report it as not configured).
ADMIN_PASSWORD=

# Optional overrides
PORT=4000

# true (default): remux/transcode each movie to a browser-playable MP4 before
# serving it (fast remux if already H.264/AAC, full re-encode otherwise).
# false: skip that step entirely and stream source files exactly as they
# are. Faster to import a large library, but playback will only work in the
# browser for files whose codecs it already supports natively.
ENCODE_LIBRARY=true

# How long a "Pair remote control" pairing code stays valid, in minutes.
# Default: 5 minutes.
PAIRING_CODE_TTL_MINUTES=5

# Number of digits in a pairing code. Default: 6.
PAIRING_CODE_LENGTH=6

# How long a paired remote's session stays resumable after its connection
# drops (e.g. the phone's screen turning off suspends its socket) before the
# pairing is torn down and a fresh pairing code is required, in minutes.
# Default: 180 minutes.
SESSION_RESUME_TTL_MINUTES=180
