# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Password required to enter admin mode in the frontend (unlocks the "Fix
# match" button on the movie detail screen). Leave unset to disable admin
# mode entirely (the lock button will report it as not configured).
ADMIN_PASSWORD=

# Optional overrides
PORT=4000

# true (default): remux/transcode each movie to a browser-playable MP4 before
# serving it (fast remux if already H.264/AAC, full re-encode otherwise).
# false: skip that step entirely and stream source files exactly as they
# are. Faster to import a large library, but playback will only work in the
# browser for files whose codecs it already supports natively.
ENCODE_LIBRARY=true
